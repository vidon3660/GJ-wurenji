    "acceptance:runtime-stream:browser": "node --env-file-if-exists=.env scripts/runtime-stream-browser-acceptance.mjs",
    "acceptance:runtime-stream:browser:all": "node --env-file-if-exists=.env scripts/runtime-stream-browser-acceptance-all.mjs",
    "acceptance:runtime-stream:browser:race": "node --env-file-if-exists=.env scripts/runtime-workspace-race-browser-acceptance.mjs",
    "acceptance:evidence": "node --env-file-if-exists=.env scripts/acceptance-evidence.mjs",
    "typecheck": "npm run typecheck --workspace @wurenji/shared && npm run typecheck --workspace @wurenji/simulation && npm run typecheck --workspace @wurenji/server && npm run typecheck --workspace @wurenji/web",
    "start": "npm run start --workspace @wurenji/server",
    "test:runtime-config": "node --test scripts/runtime-config.test.mjs"
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "playwright-core": "1.62.0",
