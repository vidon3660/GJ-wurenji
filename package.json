    "software:install": "node --env-file-if-exists=.env scripts/software-release.mjs install",
    "software:rollback": "node --env-file-if-exists=.env scripts/software-release.mjs rollback",
    "software:drill": "node --env-file-if-exists=.env scripts/software-upgrade-drill.mjs",
    "test:software:release": "node --test scripts/software-release.test.mjs",
