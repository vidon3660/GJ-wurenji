# Run npm run setup to create local .env with independently generated values.
# This template is public; actual credentials remain in the ignored .env file.
DATABASE_URL=postgresql://wurenji:replace-before-use@localhost:55432/wurenji
PRODUCTION_DATABASE_URL=
POSTGRES_PORT=55432
POSTGRES_PASSWORD=replace-before-use
JWT_SECRET=replace-with-at-least-32-random-characters
PORT=3000
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000,http://localhost:5173
TRUST_PROXY=false
SIMULATION_DATA_DIR=./data/simulation-runs
RESULT_DATA_DIR=./data/evaluation-results
V3_FILE_STORAGE_DIR=./apps/server/data/v3-files
MAP_DATA_DIR=./data/map
FORMAL_MAP_RESOURCES_REQUIRED=false
V3_FILE_STORAGE_PROVIDER=LOCAL
MINIO_ENDPOINT=localhost
MINIO_PORT=59000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-before-use
MINIO_SECRET_KEY=replace-with-a-long-random-value
MINIO_BUCKET=wurenji
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001
SIMULATION_CONCURRENCY=2
JOB_RETRY_BASE_DELAY_MS=1000
JOB_RETRY_MAX_DELAY_MS=300000
JOB_LEASE_DURATION_MS=30000
WORKER_POLL_INTERVAL_MS=500
WORKER_ERROR_DELAY_MS=5000
WORKER_BATCH_SIZE=20
WORKER_HEALTH_MAX_AGE_MS=120000
TYPEORM_SYNCHRONIZE=false
SEED_DEMO_DATA=true
DEMO_ADMIN_PASSWORD=replace-with-at-least-8-characters
DEMO_TEACHER_PASSWORD=replace-with-at-least-8-characters
DEMO_STUDENT_PASSWORD=replace-with-at-least-8-characters
DEMO_STUDENT2_PASSWORD=replace-with-at-least-8-characters
PLATFORM_VERSION=0.1.0
PLATFORM_IMAGE=wurenji-platform:0.1.0
BACKUP_IMAGE=wurenji-backup:0.1.0
RESOURCE_PACKAGE_TRUSTED_KEYS_FILE=
RESOURCE_PACKAGE_TRUSTED_KEYS_JSON=
V3_ALLOW_UNSIGNED_RESOURCE_REGISTRATION=false
ONLYOFFICE_PUBLIC_URL=http://localhost:49080
ONLYOFFICE_INTERNAL_URL=http://onlyoffice
ONLYOFFICE_JWT_SECRET=replace-with-a-long-random-value
V3_INTERNAL_API_URL=http://host.docker.internal:3000/api
ONLYOFFICE_PORT=49080
COOKIE_SECURE=false
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
TLS_CERT_DIR=./deploy/certs
DEBIAN_MIRROR=
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_OFFLINE_TERRAIN_URL=
VITE_CESIUM_ION_TOKEN=
# Cesium quantized-mesh layer.json URL; do not point this at a raw GeoTIFF.
VITE_DEM_TERRAIN_URL=
VITE_TERRAIN_REQUEST_TIMEOUT_MS=8000
VITE_ENABLE_WORLD_IMAGERY=true
VITE_ENABLE_WORLD_TERRAIN=false
VITE_ENABLE_OSM_BUILDINGS=false
PG_DUMP_COMMAND=pg_dump
PG_RESTORE_COMMAND=pg_restore
VITE_LOGISTICS_OFFLINE_IMAGERY_URL=/map/logistics/l17-orthophoto.jpg
VITE_LOGISTICS_BUILDINGS_URL=/map/logistics/buildings_clean.geojson
